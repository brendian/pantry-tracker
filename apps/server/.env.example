# Postgres connection. Either DATABASE_URL or the standard PG* variables.
# DATABASE_URL=postgres://pantry:secret@192.168.1.10:5432/pantry
PGHOST=localhost
PGPORT=5432
PGUSER=pantry
PGPASSWORD=change-me
PGDATABASE=pantry
# PGSSLMODE=disable

# HTTP server
HOST=0.0.0.0
PORT=8080

# Optional shared secret. When set, apps must send it as a Bearer token.
# API_TOKEN=

# Look up names for unknown barcodes on Open Food Facts. Set to false to keep the server fully offline.
PRODUCT_LOOKUP=true
